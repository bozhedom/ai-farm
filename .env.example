# Run npm run setup to generate local secrets. Never commit .env.
LOCAL_UID=1000
LOCAL_GID=1000
DATABASE_URL=postgres://farm:CHANGE_ME@127.0.0.1:55432/farm
TEST_DATABASE_URL=postgres://farm:CHANGE_ME@127.0.0.1:55432/farm_test
POSTGRES_PASSWORD=CHANGE_ME
APP_ORIGIN=http://localhost:3210
OWNER_PASSWORD=GENERATE_WITH_SETUP
SESSION_SECRET=GENERATE_WITH_SETUP
SECURE_COOKIE=false
MODEL_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# openrouter: the same paid GPT-6 Astra and dollar caps through OPENROUTER_API_KEY.
OPENAI_TRANSPORT=openai
# Lifetime cap across all OpenAI calls in this database; $1 = 1,000,000 microdollars.
OPENAI_TOTAL_BUDGET_MICROUSD=1000000
# Conservative accounting conversion: 120 RUB/USD, not a market exchange-rate claim.
OPENAI_USD_KOPECKS=12000
# Optional cloud alternative. This adapter accepts only openrouter/free or a model ending in :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional for reasoning models: minimal, low, medium or high. Requires provider support.
OPENROUTER_REASONING_EFFORT=
SEARCH_PROVIDER=demo
# Optional local stack: MODEL_PROVIDER=ollama, SEARCH_PROVIDER=searxng
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=300000
SEARXNG_URL=http://127.0.0.1:8088
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Upper-bound pricing in kopecks per 1000 tokens. Verify your actual tariff.
MODEL_INPUT_KOPECKS_PER_1K=100
MODEL_OUTPUT_KOPECKS_PER_1K=100
SEARCH_COST_KOPECKS=60
PAYMENT_MODE=sandbox
SEPOLIA_RPC_URL=
SEPOLIA_RECEIVER=
SEPOLIA_CONFIRMATIONS=3
MONTHLY_BUDGET_KOPECKS=300000
DAILY_BUDGET_KOPECKS=15000
ORDER_RESERVE_KOPECKS=4000
RESEARCH_RESERVE_KOPECKS=10000
# Conditional test rate for invoices: whole rubles per 1 test ETH. Not a market rate.
TEST_ETH_RUB_RATE=300000
# Let the worker find Sepolia transfers to SEPOLIA_RECEIVER without a submitted hash.
SEPOLIA_SCAN_ENABLED=true
# true only for a local anvil node imitating Sepolia (http to loopback or the compose host).
SEPOLIA_LOCAL_NODE=false
# Public site. Seller name and contact are shown to buyers; leave empty until they are real.
PUBLIC_SELLER=
PUBLIC_CONTACT=
# HTTPS link to the owner's sale terms. Empty: the site says terms are given by the seller.
PUBLIC_TERMS_URL=
# Public orders per UTC day across all buyers that are still open or paid (expired ones free a slot).
PUBLIC_ORDERS_PER_DAY=30
# Public orders that may be paid per UTC day. Each one reserves model budget at payment.
PUBLIC_PAID_ORDERS_PER_DAY=10
# Unpaid public orders one buyer address may hold open at once.
PUBLIC_OPEN_ORDERS_PER_CLIENT=2
# true lets anonymous buyers press the sandbox payment button: only for a local demo, every such
# order spends model budget. false: the owner confirms sandbox payments in the office.
PUBLIC_SANDBOX_PAY=false
# true trusts X-Forwarded-For from a reverse proxy on a private address. compose.edge.yaml sets it
# for Caddy; keep false when the app is reached directly.
TRUST_PROXY=false
# true lets search engines index /, /services/* and /terms (X-Robots-Tag is dropped there only);
# requires PUBLIC_SELLER, PUBLIC_CONTACT and PUBLIC_TERMS_URL. Order pages and the office stay noindex.
PUBLIC_INDEXING=false
# Farm reserves per task in kopecks. Free providers reserve nothing.
SCOUT_RESERVE_KOPECKS=3000
LEAD_RESERVE_KOPECKS=2000
REPORT_RESERVE_KOPECKS=2000
LEAD_DRAFTS_PER_DAY=3
IDEA_PRODUCTS_PER_DAY=2
AUTONOMY_ENABLED=true
POLL_INTERVAL_MS=5000

# Autonomous spot trading. Keys stay on the server. See docs/21-trading.md.
# trading suspends the old studio research scheduler while preserving accepted orders.
# studio runs the scouting farm (every earning direction) and trading together.
WORKSPACE_MODE=trading
OKX_API_HOST=openapi.okx.com
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET=
OKX_LIVE_PASSPHRASE=
# Live also requires owner confirmation, a verified demo round trip and mature paper evidence.
TRADING_LIVE_ENABLED=false

# Additional isolated spot accounts. Demo credentials never fall back to live.
BYBIT_API_HOST=api.bybit.com
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_SECRET=
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET=
BITGET_DEMO_API_KEY=
BITGET_DEMO_SECRET=
BITGET_DEMO_PASSPHRASE=
BITGET_LIVE_API_KEY=
BITGET_LIVE_SECRET=
BITGET_LIVE_PASSPHRASE=

# Local execution workspace. No fallback to legacy spot accounts or live credentials.
# Setup and acceptance: docs/29-execution.md. Keep disabled until individual account acceptance.
EXECUTION_LIVE_ENABLED=false
EXECUTION_LIVE_ACCEPTED_TRACKS=
EXECUTION_ARBITRAGE_ASSETS=[]
EXECUTION_ARBITRAGE_OKX_DEMO_API_KEY=
EXECUTION_ARBITRAGE_OKX_DEMO_SECRET=
EXECUTION_ARBITRAGE_OKX_DEMO_PASSPHRASE=
EXECUTION_ARBITRAGE_OKX_LIVE_API_KEY=
EXECUTION_ARBITRAGE_OKX_LIVE_SECRET=
EXECUTION_ARBITRAGE_OKX_LIVE_PASSPHRASE=
EXECUTION_ARBITRAGE_BYBIT_DEMO_API_KEY=
EXECUTION_ARBITRAGE_BYBIT_DEMO_SECRET=
EXECUTION_ARBITRAGE_BYBIT_LIVE_API_KEY=
EXECUTION_ARBITRAGE_BYBIT_LIVE_SECRET=
EXECUTION_ARBITRAGE_BINANCE_DEMO_API_KEY=
EXECUTION_ARBITRAGE_BINANCE_DEMO_SECRET=
EXECUTION_ARBITRAGE_BINANCE_LIVE_API_KEY=
EXECUTION_ARBITRAGE_BINANCE_LIVE_SECRET=
EXECUTION_ARBITRAGE_BITGET_DEMO_API_KEY=
EXECUTION_ARBITRAGE_BITGET_DEMO_SECRET=
EXECUTION_ARBITRAGE_BITGET_DEMO_PASSPHRASE=
EXECUTION_ARBITRAGE_BITGET_LIVE_API_KEY=
EXECUTION_ARBITRAGE_BITGET_LIVE_SECRET=
EXECUTION_ARBITRAGE_BITGET_LIVE_PASSPHRASE=
EXECUTION_FUNDING_BYBIT_DEMO_API_KEY=
EXECUTION_FUNDING_BYBIT_DEMO_SECRET=
EXECUTION_FUNDING_BYBIT_LIVE_API_KEY=
EXECUTION_FUNDING_BYBIT_LIVE_SECRET=
# Public deployment pins JSON or file path; private key is a separate local secret.
EXECUTION_DEFI_DEMO_CONFIG=
EXECUTION_DEFI_DEMO_PRIVATE_KEY=
EXECUTION_DEFI_LIVE_CONFIG=
EXECUTION_DEFI_LIVE_PRIVATE_KEY=
EXECUTION_PREDICTION_KALSHI_DEMO_KEY_ID=
EXECUTION_PREDICTION_KALSHI_DEMO_PRIVATE_KEY=
EXECUTION_PREDICTION_KALSHI_DEMO_ACCOUNT_ID=
EXECUTION_PREDICTION_KALSHI_DEMO_SUBACCOUNT=
EXECUTION_PREDICTION_KALSHI_LIVE_KEY_ID=
EXECUTION_PREDICTION_KALSHI_LIVE_PRIVATE_KEY=
EXECUTION_PREDICTION_KALSHI_LIVE_ACCOUNT_ID=
EXECUTION_PREDICTION_KALSHI_LIVE_SUBACCOUNT=
EXECUTION_PREDICTION_KALSHI_ELIGIBILITY_CONFIRMED=false
