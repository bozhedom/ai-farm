# Run npm run setup to generate local secrets. Never commit .env.
LOCAL_UID=1000
LOCAL_GID=1000
DATABASE_URL=postgres://farm:CHANGE_ME@127.0.0.1:55432/farm
TEST_DATABASE_URL=postgres://farm:CHANGE_ME@127.0.0.1:55432/farm_test
POSTGRES_PASSWORD=CHANGE_ME
APP_ORIGIN=http://localhost:3210
OWNER_PASSWORD=GENERATE_WITH_SETUP
SESSION_SECRET=GENERATE_WITH_SETUP
SECURE_COOKIE=false
MODEL_PROVIDER=demo
SEARCH_PROVIDER=demo
# Optional local stack: MODEL_PROVIDER=ollama, SEARCH_PROVIDER=searxng
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=300000
SEARXNG_URL=http://127.0.0.1:8088
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Upper-bound pricing in kopecks per 1000 tokens. Verify your actual tariff.
MODEL_INPUT_KOPECKS_PER_1K=100
MODEL_OUTPUT_KOPECKS_PER_1K=100
SEARCH_COST_KOPECKS=60
PAYMENT_MODE=sandbox
SEPOLIA_RPC_URL=
SEPOLIA_RECEIVER=
SEPOLIA_CONFIRMATIONS=3
MONTHLY_BUDGET_KOPECKS=300000
DAILY_BUDGET_KOPECKS=15000
ORDER_RESERVE_KOPECKS=4000
RESEARCH_RESERVE_KOPECKS=10000
AUTONOMY_ENABLED=true
POLL_INTERVAL_MS=5000
