{$DEMO_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    reverse_proxy 127.0.0.1:3211
    handle_errors {
        respond "Демонстрационный стенд временно недоступен. Компьютер с локальной моделью должен быть включён. Попробуйте позднее." 503
    }
}
