{
  "name": "ai-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3210",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "worker": "tsx --env-file=.env worker/index.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "nuxt typecheck && tsc --project tsconfig.core.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/integration --maxWorkers=1",
    "test:autonomy": "node --env-file=.env --import tsx scripts/check-autonomy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "nuxt prepare",
    "wallet:test": "tsx scripts/test-wallet.ts --check-rpc",
    "local:setup": "node scripts/local-setup.mjs",
    "quality:local": "node --env-file=.env --import tsx scripts/check-quality.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "fast-xml-parser": "5.11.1",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "uqr": "0.1.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
